{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "timeout": {
      "startup": 15000,
      "catalog": 15000,
      "execution": 30000
    },
    "servers": {
      "wqn_mark": {
        "type": "remote",
        "url": "{env:WQN_MARK_MCP_URL}",
        "oauth": false,
        "codemode": false,
        "headers": {
          "Authorization": "Bearer {env:PROBLEM_MARKING_AGENT_SECRET}"
        }
      }
    }
  }
}
