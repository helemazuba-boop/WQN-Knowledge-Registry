{
  "name": "wqn-knowledge-registry",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "GPL-3.0-only",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "validate": "node scripts/validate.ts",
    "import:skill-chunks": "node scripts/import-skill-chunks.ts",
    "embed:skill-docs": "python3 scripts/embed-skill-documents.py",
    "preflight:skill-docs": "node scripts/preflight-skill-documents.ts",
    "build": "node scripts/build.ts",
    "compatibility": "node scripts/build.ts --baseline",
    "typecheck": "tsc --noEmit",
    "test": "vitest run && python3 -m unittest tests/test_embed_skill_documents.py",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run validate && npm run build && npm run typecheck && npm test && npm run format:check"
  },
  "dependencies": {
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@huggingface/tokenizers": "^0.1.3",
    "@types/node": "^24.0.0",
    "prettier": "^3.6.2",
    "typescript": "^5.0.0",
    "vitest": "^4.0.18"
  }
}
